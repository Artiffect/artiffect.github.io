---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 flex-col items-center justify-center py-24 text-center"
  >
    <p class="text-muted-foreground text-sm font-semibold tabular-nums">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
      {t.notFound.message}
    </h1>
    <p class="text-sub mt-3 text-[15px]">
      주소가 바뀌었거나 삭제된 페이지일 수 있습니다.
    </p>
    <a href={getRelativeLocaleUrl(locale, "")} class="more-link">
      {t.notFound.goHome}
      <IconArrowRight class="size-4" />
    </a>
  </main>

  <Footer />
</Layout>
