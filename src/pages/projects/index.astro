---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectItem from "@/components/ProjectItem.astro";
import { getSortedProjects } from "@/utils/projects";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = getSortedProjects(await getCollection("projects"));
---

<Layout
  title={`${t.pages.projectsTitle} | ${config.site.title}`}
  description={`${config.site.title}가 만든 프로젝트 목록`}
>
  <Header />

  <Main
    pageTitle={t.pages.projectsTitle}
    pageDesc={projects.length > 0
      ? tplStr(t.pages.projectsDesc, { count: projects.length })
      : undefined}
  >
    {
      projects.length === 0 ? (
        <p class="text-sub py-20 text-center text-[15px]">
          아직 정리한 프로젝트가 없습니다.
        </p>
      ) : (
        <ul>
          {projects.map(project => (
            <ProjectItem {...project} />
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
