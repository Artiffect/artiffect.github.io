---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CodeCopyButtons from "@/components/CodeCopyButtons.astro";
import {
  formatPeriod,
  getProjectSlug,
  getSortedProjects,
  hasProjectPage,
} from "@/utils/projects";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const projects = getSortedProjects(await getCollection("projects"));
  return projects.filter(hasProjectPage).map(project => ({
    params: { slug: getProjectSlug(project.id) },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const { title, description, stack, team, github, demo } = project.data;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const period = formatPeriod(project.data);
const { Content } = await render(project);

const links = [
  github && { label: "GitHub", href: github },
  demo && { label: "데모", href: demo },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <main id="main-content" class="app-layout">
    <a
      href={getRelativeLocaleUrl(locale, "projects/")}
      class="page-link mt-8 text-sm"
    >
      ← {t.pages.projectsTitle}
    </a>

    <header class="mt-4 sm:mt-6">
      <h1
        class="text-[28px] leading-tight font-bold tracking-tight text-pretty sm:text-4xl"
      >
        {title}
      </h1>
      <p class="text-sub mt-3 text-[15px] leading-relaxed">{description}</p>
      <p
        class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-2 text-sm tabular-nums"
      >
        <time datetime={period.startIso}>{period.label}</time>
        {
          team && (
            <>
              <span aria-hidden="true">·</span>
              <span>{team}</span>
            </>
          )
        }
        {
          links.map(link => (
            <>
              <span aria-hidden="true">·</span>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="text-accent-ink font-medium underline-offset-4 hover:underline"
              >
                {link.label}
              </a>
            </>
          ))
        }
      </p>
      {
        stack.length > 0 && (
          <p class="text-muted-foreground mt-2 text-sm">
            <span class="sr-only">기술 스택: </span>
            {stack.join(" · ")}
          </p>
        )
      }
    </header>

    <article
      id="article"
      class="app-prose max-w-app border-border prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) mt-10 border-t pt-10"
    >
      <Content />
    </article>
    <CodeCopyButtons />
  </main>

  <Footer />
</Layout>
