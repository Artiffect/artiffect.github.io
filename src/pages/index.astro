---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import ListLayout from "@/layouts/ListLayout.astro";
import PostList from "@/components/PostList.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sorted = getSortedPosts(posts);
const recent = sorted.slice(0, config.posts.perIndex);
---

<ListLayout allPosts={posts} active="all">
  <h1 class="sr-only">{config.site.title} 최근 글</h1>
  <PostList posts={recent} />
  {
    sorted.length > recent.length && (
      <a href={getRelativeLocaleUrl(locale, "posts")} class="more-link">
        전체 글 보기 <IconArrowRight class="size-4" />
      </a>
    )
  }
</ListLayout>
