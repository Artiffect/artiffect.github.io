---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<nav
  data-pagefind-ignore
  aria-label="이전·다음 글"
  class="mt-8 grid gap-3 sm:grid-cols-2"
>
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="adjacent-link"
      >
        <span class="text-muted-foreground flex items-center gap-1 text-[13px]">
          <IconArrowLeft class="size-3.5 rtl:rotate-180" />
          {t.post.previousPost}
        </span>
        <span class="mt-1.5 line-clamp-2 font-semibold">{prevPost.title}</span>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="adjacent-link sm:col-start-2 sm:text-end"
      >
        <span class="text-muted-foreground flex items-center gap-1 text-[13px] sm:justify-end">
          {t.post.nextPost}
          <IconArrowRight class="size-3.5 rtl:rotate-180" />
        </span>
        <span class="mt-1.5 line-clamp-2 font-semibold">{nextPost.title}</span>
      </a>
    )
  }
</nav>
