---
import type { GetStaticPathsOptions } from "astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ListLayout from "@/layouts/ListLayout.astro";
import PostList from "@/components/PostList.astro";
import Pagination from "@/components/Pagination.astro";
import {
  ALL_CATEGORIES,
  getCategoryFamily,
  getCategoryLabel,
  getTopCategorySlug,
} from "@/data/categories";
import { getCategoryCounts } from "@/utils/getCategoryCounts";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts");
  const sorted = getSortedPosts(posts);

  // 상위·하위 모두 글이 있는 카테고리만 페이지를 만든다. 상위 페이지에는 하위 글도 모은다.
  return ALL_CATEGORIES.flatMap(category => {
    const family = getCategoryFamily(category.slug);
    const categoryPosts = sorted.filter(p => family.includes(p.data.category));
    if (categoryPosts.length === 0) return [];
    return paginate(categoryPosts, {
      params: { category: category.slug },
      props: { category, allPosts: posts },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, category, allPosts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

// 모바일 하위 칩: 이 카테고리(또는 부모)의 하위 카테고리 중 글이 있는 것
const topSlug = getTopCategorySlug(category.slug);
const top = getCategoryCounts(allPosts).categories.find(
  c => c.slug === topSlug
);
const subChips =
  top && top.children.length > 0
    ? [{ slug: top.slug, label: "전체", count: top.count }, ...top.children]
    : [];
---

<ListLayout
  title={`${getCategoryLabel(category.slug)} | ${config.site.title}`}
  allPosts={allPosts}
  active={category.slug}
>
  <h1 class="list-title">
    {category.label}
    <span class="side-count">{page.total}</span>
  </h1>
  {
    category.slug === "photo" && (
      <a
        href={getRelativeLocaleUrl(locale, "photos/")}
        class="page-link mb-6 text-[15px] lg:-mt-4"
      >
        사진만 모아 보기 <IconArrowRight class="size-4" />
      </a>
    )
  }
  {
    subChips.length > 0 && (
      <nav aria-label="하위 카테고리" class="mt-3 mb-2 lg:hidden">
        <ul class="flex flex-wrap gap-1.5 tabular-nums">
          {subChips.map(chip => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `categories/${chip.slug}/`)}
                class:list={[
                  "tag-chip-sm",
                  { "tag-chip-active": chip.slug === category.slug },
                ]}
                aria-current={chip.slug === category.slug ? "page" : undefined}
              >
                {chip.label}
                <span class="side-count">{chip.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <PostList posts={page.data} />
  <Pagination {page} />
</ListLayout>
