---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import ListLayout from "@/layouts/ListLayout.astro";
import PostList from "@/components/PostList.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts");
  const sorted = getSortedPosts(posts);

  return getUniqueTags(posts).flatMap(({ tag, tagName }) =>
    paginate(
      sorted.filter(({ data }) => slugifyAll(data.tags).includes(tag)),
      {
        params: { tag },
        props: { tagName, allPosts: posts },
        pageSize: config.posts.perPage,
      }
    )
  );
}

const { page, tagName, allPosts } = Astro.props;
const { tag } = Astro.params;
---

<ListLayout
  title={`#${tagName} | ${config.site.title}`}
  allPosts={allPosts}
  activeTag={tag}
>
  <h1 class="list-title">
    <span><span class="text-accent-ink">#</span>{tagName}</span>
    <span class="side-count">{page.total}</span>
  </h1>
  <PostList posts={page.data} />
  <Pagination {page} />
</ListLayout>
