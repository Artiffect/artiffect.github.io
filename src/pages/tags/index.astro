---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import ListLayout from "@/layouts/ListLayout.astro";
import { getTagCounts } from "@/utils/getTagCounts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const tags = getTagCounts(posts);
---

<ListLayout title={`태그 | ${config.site.title}`} allPosts={posts}>
  <h1 class="list-title">
    태그 <span class="side-count">{tags.length}</span>
  </h1>
  {
    tags.length === 0 ? (
      <p class="text-sub py-20 text-center text-[15px]">
        아직 태그가 없습니다.
      </p>
    ) : (
      <ul class="flex flex-wrap gap-2 tabular-nums">
        {tags.map(t => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `tags/${t.tag}/`)}
              class="tag-chip gap-1.5"
            >
              {t.tagName}
              <span class="side-count">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</ListLayout>
