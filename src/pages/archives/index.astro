---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getCategoryLabel } from "@/data/categories";
import { formatDate } from "@/utils/formatDate";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

// 모든 공개 글을 연도별로 묶은 한 줄 목록 (홈보다 촘촘하게)
const posts = getSortedPosts(await getCollection("posts"));
type Row = {
  post: CollectionEntry<"posts">;
  date: ReturnType<typeof formatDate>;
};
const groups: { year: number; rows: Row[] }[] = [];
for (const post of posts) {
  const date = formatDate(post.data.pubDatetime, post.data.timezone);
  const last = groups.at(-1);
  if (last?.year === date.year) last.rows.push({ post, date });
  else groups.push({ year: date.year, rows: [{ post, date }] });
}
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={t.pages.archivesTitle}
    pageDesc={`지금까지 쓴 글 ${posts.length}개`}
  >
    {
      groups.length === 0 ? (
        <p class="text-sub py-20 text-center text-[15px]">
          아직 공개한 글이 없습니다.
        </p>
      ) : (
        groups.map(({ year, rows }) => (
          <section class="mb-10" aria-labelledby={`archive-${year}`}>
            <h2
              id={`archive-${year}`}
              class="text-muted-foreground after:bg-border flex items-center gap-3.5 text-sm font-semibold tabular-nums after:h-px after:flex-1"
            >
              {year}
            </h2>
            <ul class="mt-2">
              {rows.map(({ post, date }) => (
                <li>
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    class="group grid grid-cols-[4rem_minmax(0,1fr)_auto] items-baseline gap-3 py-2.5"
                  >
                    <time
                      datetime={date.iso}
                      class="text-muted-foreground text-sm tabular-nums"
                    >
                      {date.short}
                    </time>
                    <span class="group-hover:text-accent-ink truncate font-medium transition-colors">
                      {post.data.title}
                    </span>
                    <span class="text-muted-foreground text-[13px] max-sm:hidden">
                      {getCategoryLabel(post.data.category)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </Main>

  <Footer />
</Layout>
