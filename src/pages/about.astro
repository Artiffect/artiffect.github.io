---
// 소개 페이지. 내용은 src/data/about.ts 에서 고친다.
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { ABOUT } from "@/data/about";
import { PROFILE } from "@/data/profile";
import config from "@/config";

const name = PROFILE.name ?? config.site.author;
---

<Layout title={`소개 | ${config.site.title}`} description={ABOUT.headline}>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <!-- 머리 -->
    <section class="mt-10 flex flex-col gap-6 sm:flex-row sm:items-start">
      {
        PROFILE.avatar && (
          <Image
            src={PROFILE.avatar}
            alt=""
            width={192}
            height={192}
            class="border-border size-24 shrink-0 rounded-full border object-cover"
          />
        )
      }
      <div>
        <p class="text-sub text-[15px]">
          <span class="text-foreground font-semibold">{name}</span> · {
            ABOUT.role
          }
        </p>
        <h1
          class="mt-2 text-2xl leading-snug font-bold tracking-tight text-pretty sm:text-[28px]"
        >
          {ABOUT.headline}
        </h1>
        <p class="text-sub mt-4 text-[15px] leading-relaxed text-pretty">
          {ABOUT.intro}
        </p>
        <ul class="mt-4 flex gap-4 text-[15px]">
          {
            ABOUT.links.map(link => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="text-accent-ink font-medium underline-offset-4 hover:underline"
                >
                  {link.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 기술 -->
    <section class="about-row mt-12">
      <h2 class="about-label">기술</h2>
      <dl class="grid gap-x-6 gap-y-2.5 sm:grid-cols-[112px_1fr]">
        {
          ABOUT.skills.map(s => (
            <>
              <dt class="text-muted-foreground text-sm sm:pt-px">{s.group}</dt>
              <dd class="text-[15px] max-sm:mb-2">{s.items.join(" · ")}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <!-- 프로젝트 -->
    <section class="about-row">
      <h2 class="about-label">프로젝트</h2>
      <ul class="space-y-7">
        {
          ABOUT.projects.map(p => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="text-[17px] font-bold">{p.name}</h3>
                <span class="text-muted-foreground text-sm tabular-nums">
                  {p.period}
                </span>
              </div>
              <p class="mt-1 text-[15px]">{p.summary}</p>
              <p class="text-sub mt-1 text-sm">{p.highlights}</p>
              <p class="text-muted-foreground mt-1.5 text-[13.5px]">
                {[p.role, p.team, p.note].filter(Boolean).join(" · ")}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 교육 -->
    <section class="about-row">
      <h2 class="about-label">교육</h2>
      <ul class="space-y-2.5">
        {
          ABOUT.education.map(e => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-[15px]">
              <span>{e.name}</span>
              <span class="text-muted-foreground text-sm tabular-nums">
                {e.period}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 자격증 -->
    <section class="about-row">
      <h2 class="about-label">자격증</h2>
      <ul class="space-y-2.5">
        {
          ABOUT.certifications.map(c => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-[15px]">
              <span>
                {c.name}
                <span class="text-muted-foreground ms-1.5 text-sm">
                  {c.org}
                </span>
              </span>
              <span class="text-muted-foreground text-sm tabular-nums">
                {c.date}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 이 블로그 -->
    <section class="about-row">
      <h2 class="about-label">이 블로그</h2>
      <p class="text-[15px] leading-relaxed text-pretty">{ABOUT.blog}</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about-row {
    display: grid;
    gap: 12px;
    padding-block: 32px;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .about-row {
      grid-template-columns: 120px 1fr;
      gap: 24px;
    }
  }
  .about-label {
    font-size: 15px;
    font-weight: 700;
  }
</style>
