---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image, getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const formatDay = (d: Date) =>
  `${d.getUTCFullYear()}. ${String(d.getUTCMonth() + 1).padStart(2, "0")}. ${String(d.getUTCDate()).padStart(2, "0")}.`;

// 사진 글이 있으면 "사진 글 보기" 링크를 단다
const photoPostCount = (
  await getCollection(
    "posts",
    p => p.data.category === "photo" && !p.data.draft
  )
).length;

// 최신 사진이 위로
const photos = await Promise.all(
  (await getCollection("photos"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(async ({ id, data }) => {
      const full = await getImage({ src: data.image, width: 1920 });
      const meta = [formatDay(data.date), data.camera, data.lens]
        .filter(Boolean)
        .join(" · ");
      return { id, ...data, full: full.src, meta };
    })
);
---

<Layout
  title={`${t.pages.photosTitle} | ${config.site.title}`}
  description={`${config.site.title}가 찍은 사진`}
>
  <Header />

  <Main
    pageTitle={t.pages.photosTitle}
    pageDesc={photos.length > 0
      ? tplStr(t.pages.photosDesc, { count: photos.length })
      : undefined}
  >
    {
      photoPostCount > 0 && (
        <a
          href={getRelativeLocaleUrl(locale, "categories/photo/")}
          class="page-link -mt-4 mb-6 text-[15px]"
        >
          사진 글 보기 <IconArrowRight class="size-4" />
        </a>
      )
    }
    {
      photos.length === 0 ? (
        <p class="text-sub py-20 text-center text-[15px]">
          아직 올린 사진이 없습니다.
        </p>
      ) : (
        <ul class="columns-2 gap-3 sm:columns-3" id="photo-grid">
          {photos.map((photo, i) => (
            <li class="mb-3 break-inside-avoid">
              <button
                type="button"
                class="photo-item block w-full cursor-zoom-in overflow-hidden rounded-lg"
                data-index={i}
                data-full={photo.full}
                data-caption={photo.caption ?? ""}
                data-meta={photo.meta}
                aria-label={`${photo.caption || photo.meta} 크게 보기`}
              >
                <Image
                  src={photo.image}
                  alt={photo.caption || photo.meta}
                  widths={[480, 960]}
                  sizes="(min-width: 640px) 33vw, 50vw"
                  class="h-auto w-full transition-opacity hover:opacity-90"
                  loading={i < 6 ? "eager" : "lazy"}
                />
              </button>
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <dialog
    id="photo-viewer"
    class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/85"
    aria-label="사진 크게 보기"
  >
    <figure
      class="flex max-h-[92vh] w-[min(92vw,1600px)] flex-col items-center"
    >
      <img
        id="photo-viewer-img"
        alt=""
        class="max-h-[80vh] w-auto max-w-full rounded-lg object-contain"
      />
      <figcaption class="mt-4 text-center">
        <p id="photo-viewer-caption" class="text-[15px] text-white"></p>
        <p
          id="photo-viewer-meta"
          class="mt-1 text-sm text-white/60 tabular-nums"
        >
        </p>
      </figcaption>
    </figure>
    <button
      type="button"
      data-viewer="close"
      class="viewer-btn fixed top-4 right-4"
      aria-label="닫기">✕</button
    >
    <button
      type="button"
      data-viewer="prev"
      class="viewer-btn fixed top-1/2 left-4 -translate-y-1/2"
      aria-label="이전 사진">‹</button
    >
    <button
      type="button"
      data-viewer="next"
      class="viewer-btn fixed top-1/2 right-4 -translate-y-1/2"
      aria-label="다음 사진">›</button
    >
  </dialog>

  <Footer />
</Layout>

<style>
  .viewer-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    color: rgb(255 255 255 / 0.75);
    font-size: 22px;
    line-height: 1;
  }
  .viewer-btn:hover {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }
  .viewer-btn[hidden] {
    display: none;
  }
</style>

<script>
  function setupPhotoViewer() {
    const dialog = document.querySelector<HTMLDialogElement>("#photo-viewer");
    const items = [
      ...document.querySelectorAll<HTMLButtonElement>(".photo-item"),
    ];
    if (!dialog || items.length === 0) return;

    const img = dialog.querySelector<HTMLImageElement>("#photo-viewer-img")!;
    const caption = dialog.querySelector("#photo-viewer-caption")!;
    const meta = dialog.querySelector("#photo-viewer-meta")!;
    const prev = dialog.querySelector<HTMLButtonElement>("[data-viewer=prev]")!;
    const next = dialog.querySelector<HTMLButtonElement>("[data-viewer=next]")!;
    let current = 0;

    const show = (index: number) => {
      current = (index + items.length) % items.length;
      const {
        full = "",
        caption: text = "",
        meta: info = "",
      } = items[current].dataset;
      img.src = full;
      img.alt = text || info;
      caption.textContent = text;
      caption.toggleAttribute("hidden", !text);
      meta.textContent = info;
    };

    prev.hidden = next.hidden = items.length < 2;

    items.forEach((item, i) =>
      item.addEventListener("click", () => {
        show(i);
        dialog.showModal();
      })
    );
    prev.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));
    dialog
      .querySelector("[data-viewer=close]")!
      .addEventListener("click", () => dialog.close());
    // 사진 바깥(어두운 배경)을 누르면 닫기
    dialog.addEventListener("click", e => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", e => {
      if (items.length < 2) return;
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  }

  document.addEventListener("astro:page-load", setupPhotoViewer);
</script>
