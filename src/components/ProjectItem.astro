---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatPeriod, getProjectUrl, hasProjectPage } from "@/utils/projects";

type Props = { headingLevel?: "h2" | "h3" } & CollectionEntry<"projects">;

const { headingLevel: Heading = "h2", ...project } = Astro.props;
const { id, data } = project;
const { title, description, stack, team, github, demo, thumbnail } = data;

const period = formatPeriod(data);

// 제목 링크: 상세 페이지 → 없으면 GitHub → 데모 → 둘 다 없으면 링크 없음
const detailUrl = hasProjectPage(project)
  ? getProjectUrl(id, Astro.currentLocale)
  : undefined;
const titleHref = detailUrl ?? github ?? demo;
const isExternal = !detailUrl && Boolean(titleHref);

const links = [
  github && { label: "GitHub", href: github },
  demo && { label: "데모", href: demo },
].filter(Boolean) as { label: string; href: string }[];
---

<li
  class="group border-border relative grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b py-6 last:border-b-0 sm:gap-8"
>
  <div class="min-w-0">
    <Heading
      class="text-[17.5px] leading-snug font-bold tracking-tight sm:text-xl"
    >
      {
        titleHref ? (
          /* after:inset-0 → 줄 전체를 눌러도 이동 */
          <a
            href={titleHref}
            class="group-hover:text-accent-ink transition-colors after:absolute after:inset-0"
            {...(isExternal && { target: "_blank", rel: "noopener" })}
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </Heading>
    <p class="text-sub mt-1.5 line-clamp-2 text-[15px] leading-relaxed">
      {description}
    </p>
    {
      stack.length > 0 && (
        <p class="text-muted-foreground mt-3 text-[13.5px]">
          <span class="sr-only">기술 스택: </span>
          {stack.join(" · ")}
        </p>
      )
    }
    <p
      class="text-muted-foreground mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[13px] tabular-nums"
    >
      <time datetime={period.startIso}>{period.label}</time>
      {team && <span>{team}</span>}
      {
        links.map(link => (
          /* relative z-10 → 줄 전체 링크 위에서 따로 눌림 */
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            class="text-sub hover:text-foreground decoration-border relative z-10 underline underline-offset-4 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </p>
  </div>
  {
    thumbnail && (
      <Image
        src={thumbnail}
        alt=""
        width={336}
        height={208}
        class="border-border h-[66px] w-[88px] rounded-lg border object-cover sm:h-[104px] sm:w-[168px]"
      />
    )
  }
</li>
