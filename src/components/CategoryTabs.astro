---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTopCategorySlug, type CategorySlug } from "@/data/categories";
import { getCategoryCounts } from "@/utils/getCategoryCounts";
import { getTagCounts } from "@/utils/getTagCounts";
import config from "@/config";

type Props = {
  posts: CollectionEntry<"posts">[];
  active?: CategorySlug | "all";
};

const { posts, active: activeProp } = Astro.props;
// 탭에는 상위 카테고리만 있으므로, 하위 카테고리 페이지에서는 부모 탭을 켠다
const active =
  activeProp && activeProp !== "all"
    ? getTopCategorySlug(activeProp)
    : activeProp;
const locale = Astro.currentLocale ?? config.site.lang;
const { total, categories } = getCategoryCounts(posts);
// 모바일에서는 사이드바 태그 칩이 숨겨지므로 탭 끝에 태그 목록 입구를 둔다
const tagCount = getTagCounts(posts).length;

const items = [
  {
    key: "all",
    label: "전체",
    count: total,
    href: getRelativeLocaleUrl(locale, "posts"),
  },
  ...categories.map(c => ({
    key: c.slug,
    label: c.label,
    count: c.count,
    href: getRelativeLocaleUrl(locale, `categories/${c.slug}/`),
  })),
  ...(tagCount > 0
    ? [
        {
          key: "tags",
          label: "태그",
          count: tagCount,
          href: getRelativeLocaleUrl(locale, "tags"),
        },
      ]
    : []),
];
---

<nav class="border-border -mx-4 mb-2 border-b lg:hidden" aria-label="카테고리">
  <ul
    class="flex [scrollbar-width:none] gap-5 overflow-x-auto px-4 whitespace-nowrap tabular-nums"
  >
    {
      items.map(item => (
        <li>
          <a
            href={item.href}
            class:list={["cat-tab", { "cat-tab-active": active === item.key }]}
            aria-current={active === item.key ? "page" : undefined}
          >
            {item.label} <span class="side-count">{item.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
