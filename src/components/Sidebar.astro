---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CategorySlug } from "@/data/categories";
import { PROFILE } from "@/data/profile";
import { getCategoryCounts } from "@/utils/getCategoryCounts";
import { getTagCounts } from "@/utils/getTagCounts";
import config from "@/config";

type Props = {
  posts: CollectionEntry<"posts">[];
  active?: CategorySlug | "all"; // 현재 보고 있는 카테고리
  activeTag?: string; // 현재 보고 있는 태그 (slug)
};

const { posts, active, activeTag } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const { total, categories } = getCategoryCounts(posts);

const TAG_LIMIT = 12; // 넘치면 "전체 태그 보기"
const tags = getTagCounts(posts);

const name = PROFILE.name ?? config.site.author;
const bio = PROFILE.bio ?? config.site.description;
---

<aside
  class="max-lg:hidden lg:sticky lg:top-10 lg:self-start"
  aria-label="블로그 정보"
>
  <section>
    {
      PROFILE.avatar ? (
        <Image
          src={PROFILE.avatar}
          alt=""
          width={128}
          height={128}
          class="size-16 rounded-2xl object-cover"
        />
      ) : (
        <div
          aria-hidden="true"
          class="bg-muted text-muted-foreground flex size-16 items-center justify-center rounded-2xl text-2xl font-bold"
        >
          {name.charAt(0).toUpperCase()}
        </div>
      )
    }
    <p class="mt-4 text-[17px] font-bold tracking-tight">{name}</p>
    <p class="text-sub mt-1.5 text-sm leading-relaxed text-pretty">{bio}</p>
    <ul class="text-sub mt-3 flex gap-3 text-[13.5px]">
      {
        PROFILE.links.map(link => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class="decoration-border hover:text-foreground underline underline-offset-3"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="mt-10" aria-labelledby="side-categories">
    <h2 id="side-categories" class="side-heading">카테고리</h2>
    <ul class="tabular-nums">
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class:list={["side-cat", { "side-cat-active": active === "all" }]}
          aria-current={active === "all" ? "page" : undefined}
        >
          전체 <span class="side-count">{total}</span>
        </a>
      </li>
      {
        categories.map(c => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${c.slug}/`)}
              class:list={[
                "side-cat",
                { "side-cat-active": active === c.slug },
              ]}
              aria-current={active === c.slug ? "page" : undefined}
            >
              {c.label} <span class="side-count">{c.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    tags.length > 0 && (
      <section class="mt-10" aria-labelledby="side-tags">
        <h2 id="side-tags" class="side-heading">
          태그
        </h2>
        <ul class="flex flex-wrap gap-1.5 tabular-nums">
          {tags.slice(0, TAG_LIMIT).map(t => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, `tags/${t.tag}/`)}
                class:list={[
                  "tag-chip-sm",
                  { "tag-chip-active": activeTag === t.tag },
                ]}
                aria-current={activeTag === t.tag ? "page" : undefined}
              >
                {t.tagName}
                <span class="side-count">{t.count}</span>
              </a>
            </li>
          ))}
        </ul>
        {tags.length > TAG_LIMIT && (
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class="text-sub hover:text-foreground mt-3 inline-block text-[13px] underline underline-offset-3"
          >
            전체 태그 보기
          </a>
        )}
      </section>
    )
  }
</aside>
