---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav
      class="border-border mt-10 grid grid-cols-3 items-center border-t pt-6 text-[15px]"
      aria-label="페이지 이동"
    >
      <div>
        {page.url.prev && (
          <a
            href={page.url.prev}
            class="page-link"
            aria-label={t.a11y.goToPreviousPage}
          >
            <IconArrowLeft class="size-4" />
            {t.pagination.prev}
          </a>
        )}
      </div>
      <p class="text-muted-foreground text-center text-sm tabular-nums">
        {page.currentPage} / {page.lastPage}
      </p>
      <div class="text-right">
        {page.url.next && (
          <a
            href={page.url.next}
            class="page-link"
            aria-label={t.a11y.goToNextPage}
          >
            {t.pagination.next}
            <IconArrowRight class="size-4" />
          </a>
        )}
      </div>
    </nav>
  )
}
